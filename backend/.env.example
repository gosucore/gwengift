# Copy to backend/.env for local development. Never commit real credentials.
GWENGIFT_ENVIRONMENT=development
GWENGIFT_DATABASE_URL=sqlite:///./data/gwengift.db
GWENGIFT_TELEGRAM_BOT_TOKEN=
GWENGIFT_DEV_IDENTITY_ENABLED=false
GWENGIFT_INIT_DATA_MAX_AGE_SECONDS=300
GWENGIFT_STARTING_DEMO_BALANCE=10000
GWENGIFT_MANUAL_DATA_MAX_AGE_HOURS=24
GWENGIFT_EXTERNAL_DATA_MAX_AGE_HOURS=48
GWENGIFT_MARKET_DISCREPANCY_THRESHOLD=0.35
GWENGIFT_MARKET_DISCREPANCY_ACTION=pause
GWENGIFT_DISCREPANCY_LIQUIDITY_DISCOUNT=0.25
GWENGIFT_TG_GIFTS_DAILY_URL=https://tggifts.com/data/floors-daily.json
GWENGIFT_MARKET_CACHE_PATH=./data/tg-gifts-cache.json
GWENGIFT_WORKER_POLL_INTERVAL_SECONDS=1
GWENGIFT_FRONTEND_DIST_PATH=../frontend/dist
GWENGIFT_TRACING_ENABLED=false
GWENGIFT_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
GWENGIFT_TRACING_SERVICE_NAMESPACE=gwengift
