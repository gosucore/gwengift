class GTElement:
    pass

class G2Element:
    @classmethod
    def from_bytes(cls, value: bytes) -> G2Element: ...
    @classmethod
    def generator(cls) -> G2Element: ...

class G1Element:
    @classmethod
    def from_bytes(cls, value: bytes) -> G1Element: ...
    @classmethod
    def from_message(cls, message: bytes, dst: bytes) -> G1Element: ...
    def pair(self, other: G2Element) -> GTElement: ...
